# ------------ Data Source Concepts ------------------ #

### https://www.gate-ai.eu/gds#SensorsDataSource
gds:SensorsDataSource a dpv:DataSource ;
    rdfs:label "Sensors Data Source"@en ;
    rdfs:definition "Data source representing data collected from sensors deployed in urban environments."@en ;
    rdfs:isDefinedBy gds: .

### https://www.gate-ai.eu/gds#TrafficMonitoringInfrastructure
gds:TrafficMonitoringInfrastructure a dpv:DataSource ;
    rdfs:label "Traffic Monitoring Infrastructure"@en ;
    rdfs:definition "Data source representing data collected from traffic monitoring infrastructure in urban environments."@en ;
    rdfs:isDefinedBy gds: .

# ------------ Status Concepts ------------------ #

### https://www.gate-ai.eu/gds#Available
gds:Available a owl:Class, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Available Status"@en ;
    skos:definition "Status of asset that is available"@en .

### https://www.gate-ai.eu/gds#ReservedByRightholder
gds:ReservedByRightholder a owl:Class, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Reserved By Rightholder Status"@en ;
    skos:definition "Status of asset that is reserved by rightholder"@en .

### https://www.gate-ai.eu/gds#Active
gds:Active a owl:Class, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Active Status" ;
    skos:definition "Status of participant that is active" .

### https://www.gate-ai.eu/gds#Suspended
gds:Suspended a owl:Class, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Suspended Status" ;
    skos:definition "Status of participant that is suspended" .

# ------------ Policy Level Concepts ------------------ #

### https://www.gate-ai.eu/gds#policyLevel
gds:policyLevel a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:domain odrl:Policy ;
    rdfs:range gds:PolicyLevel ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Policy Level (ISO/IEC WD3 20151)" ;
    skos:definition "Defines the overarching policy level according to ISO/IEC WD3 20151 - dataspace, discovery, contract, use"@en .

### https://www.gate-ai.eu/gds#PolicyLevel
gds:PolicyLevel a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Policy Level" ;
    skos:definition "Policy Level class according to ISO/IEC WD3 20151 - dataspace, discovery, contract, use"@en .

### https://www.gate-ai.eu/gds#DataspaceLevel
gds:DataspaceLevel a owl:NamedIndividual, skos:Concept, gds:PolicyLevel ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Dataspace Level" ;
    skos:definition "Dataspace /Membership/ Policies" .

### https://www.gate-ai.eu/gds#DiscoveryLevel
gds:DiscoveryLevel a owl:NamedIndividual, skos:Concept, gds:PolicyLevel ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Discovery Level" ;
    skos:definition "Discovery /Access/ Policies" .

### https://www.gate-ai.eu/gds#ContractLevel
gds:ContractLevel a owl:NamedIndividual, skos:Concept, gds:PolicyLevel ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Data Contract Level" ;
    skos:definition "Contract Policies" .

### https://www.gate-ai.eu/gds#UseLevel
gds:UseLevel a owl:NamedIndividual, skos:Concept, gds:PolicyLevel ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Data Use Level" ;
    skos:definition "Data Use Policies" .